---
interface Props {
  title: string;
  activePage?: 'productos' | 'clientes' | 'pedidos' | 'home';
}

const { title, activePage = 'home' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Taller Astro SSG</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />
    <style>
      body {
        background-color: #f8f9fa;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .dsb-container {
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        padding: 1.5rem;
        margin-top: 1.5rem;
        margin-bottom: 2rem;
      }
      .container-header {
        border-bottom: 2px solid #e9ecef;
        padding-bottom: 0.75rem;
        margin-bottom: 1.5rem;
      }
      .nav-link.active {
        font-weight: 600;
        color: #0d6efd !important;
      }
    </style>
  </head>
  <body>
    <!-- Navbar Organism equivalente al de Angular -->
    <header class="mx-md-5 my-2">
      <nav class="navbar navbar-expand-lg navbar-light bg-white rounded shadow-sm px-3 border">
        <div class="container-fluid">
          <a class="navbar-brand d-flex align-items-center fw-bold text-primary" href="/">
            <i class="bi bi-bootstrap-fill fs-3 me-2 text-primary"></i>
            <span>Taller Sistema de Diseño</span>
            <span class="badge bg-secondary ms-2 fs-6">SSG (Astro)</span>
          </a>
          <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarContent"
          >
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarContent">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
              <li class="nav-item">
                <a class={`nav-link ${activePage === 'home' ? 'active' : ''}`} href="/">
                  <i class="bi bi-house-door me-1"></i> Inicio
                </a>
              </li>
              <li class="nav-item">
                <a class={`nav-link ${activePage === 'productos' ? 'active' : ''}`} href="/productos">
                  <i class="bi bi-box-seam me-1"></i> Productos
                </a>
              </li>
              <li class="nav-item">
                <a class={`nav-link ${activePage === 'clientes' ? 'active' : ''}`} href="/clientes">
                  <i class="bi bi-people me-1"></i> Clientes
                </a>
              </li>
              <li class="nav-item">
                <a class={`nav-link ${activePage === 'pedidos' ? 'active' : ''}`} href="/pedidos">
                  <i class="bi bi-cart-check me-1"></i> Pedidos
                </a>
              </li>
            </ul>
          </div>
        </div>
      </nav>
    </header>

    <!-- Main Content Container -->
    <main class="container-fluid px-md-5 flex-grow-1">
      <slot />
    </main>

    <footer class="bg-white border-top py-3 text-center text-muted small mt-auto">
      <div class="container">
        <span>Taller UCEVA — Comparativa SPA (Angular) vs SSG (Astro) | Juan Fernando Vargas</span>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
