---
import Layout from '../layouts/Layout.astro';

// Directorio de clientes iniciales (SSG)
const initialClientes = [
  {
    id: 'c-1',
    nombre: 'Valentina González',
    email: 'valentina.gonzalez06@uceva.edu.co',
    ciudad: 'Tuluá',
  },
  {
    id: 'c-2',
    nombre: 'Carlos Andrés Pérez',
    email: 'carlos.perez@ejemplo.com',
    ciudad: 'Cali',
  },
  {
    id: 'c-3',
    nombre: 'Mariana López',
    email: 'mariana.lopez@ejemplo.com',
    ciudad: 'Bogotá',
  },
  {
    id: 'c-4',
    nombre: 'Juan Fernando Vargas',
    email: 'juan.vargas03@uceva.edu.co',
    ciudad: 'Tuluá',
  },
  {
    id: 'c-5',
    nombre: 'Sofía Ramirez Castro',
    email: 'sofia.ramirez@ejemplo.com',
    ciudad: 'Medellín',
  }
];
---

<Layout title="Módulo de Clientes (SSG)" activePage="clientes">
  <div class="dsb-container">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h2 class="h3 fw-bold text-dark mb-0">Módulo de Clientes (SSG)</h2>
        <p class="text-muted mb-0">Directorio de clientes registrados con pre-renderizado estático</p>
      </div>
      <button
        type="button"
        id="btn-refrescar-clientes"
        class="btn btn-primary d-flex align-items-center"
      >
        <i class="bi bi-arrow-clockwise me-1"></i>
        Refrescar Datos
      </button>
    </div>

    <div id="alert-cargando-cli" class="alert alert-info d-none align-items-center" role="alert">
      <div class="spinner-border spinner-border-sm me-2 text-info" role="status"></div>
      <span>Cargando directorio de clientes desde el servidor...</span>
    </div>

    <!-- Formulario de Registro de Cliente -->
    <div class="row mb-4">
      <div class="col-12">
        <div class="card shadow-sm border-0">
          <div class="card-header bg-success text-white">
            <h5 class="mb-0 fs-6 fw-bold">Registrar Nuevo Cliente</h5>
          </div>
          <div class="card-body">
            <form id="form-cliente">
              <div class="row g-3">
                <div class="col-md-4">
                  <label for="cli-nombre" class="form-label small fw-semibold">Nombre Completo <span class="text-danger">*</span></label>
                  <input
                    type="text"
                    class="form-control"
                    id="cli-nombre"
                    placeholder="Ej. Juan Pérez"
                    required
                  />
                </div>
                <div class="col-md-4">
                  <label for="cli-email" class="form-label small fw-semibold">Correo Electrónico <span class="text-danger">*</span></label>
                  <input
                    type="email"
                    class="form-control"
                    id="cli-email"
                    placeholder="ejemplo@correo.com"
                    required
                  />
                </div>
                <div class="col-md-4">
                  <label for="cli-ciudad" class="form-label small fw-semibold">Ciudad</label>
                  <input
                    type="text"
                    class="form-control"
                    id="cli-ciudad"
                    placeholder="Ej. Tuluá"
                  />
                </div>
              </div>
              <div class="mt-3 text-end">
                <button
                  type="submit"
                  id="btn-guardar-cliente"
                  class="btn btn-success"
                >
                  <i class="bi bi-person-check me-1"></i>
                  Guardar Cliente
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- Tabla de Clientes -->
    <div class="table-responsive">
      <table class="table table-hover table-striped align-middle border">
        <thead class="table-dark">
          <tr>
            <th style="width: 20%;">ID</th>
            <th style="width: 30%;">Nombre</th>
            <th style="width: 30%;">Correo Electrónico</th>
            <th style="width: 20%;">Ciudad</th>
          </tr>
        </thead>
        <tbody id="tabla-clientes-body">
          {initialClientes.map((cli) => (
            <tr>
              <td><code>{cli.id}</code></td>
              <td class="fw-bold">{cli.nombre}</td>
              <td>
                <a href={`mailto:${cli.email}`} class="text-decoration-none text-primary">
                  <i class="bi bi-envelope me-1"></i>
                  {cli.email}
                </a>
              </td>
              <td>
                <span class="badge bg-secondary text-white">
                  {cli.ciudad}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <script>
    const formCli = document.getElementById('form-cliente') as HTMLFormElement;
    const tbodyCli = document.getElementById('tabla-clientes-body') as HTMLElement;
    const btnRefrescarCli = document.getElementById('btn-refrescar-clientes') as HTMLButtonElement;
    const alertCargandoCli = document.getElementById('alert-cargando-cli') as HTMLElement;

    function agregarFilaCliente(cli: any) {
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td><code>${cli.id}</code></td>
        <td class="fw-bold">${cli.nombre}</td>
        <td>
          <a href="mailto:${cli.email}" class="text-decoration-none text-primary">
            <i class="bi bi-envelope me-1"></i>
            ${cli.email}
          </a>
        </td>
        <td><span class="badge bg-secondary text-white">${cli.ciudad || 'No especificada'}</span></td>
      `;
      tbodyCli.prepend(tr);
    }

    formCli?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const nombreInput = document.getElementById('cli-nombre') as HTMLInputElement;
      const emailInput = document.getElementById('cli-email') as HTMLInputElement;
      const ciudadInput = document.getElementById('cli-ciudad') as HTMLInputElement;

      const nuevoCliente = {
        id: 'c-' + Date.now().toString().slice(-4),
        nombre: nombreInput.value,
        email: emailInput.value,
        ciudad: ciudadInput.value || 'No especificada',
      };

      try {
        await fetch('http://localhost:3000/api/clientes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(nuevoCliente),
        });
      } catch (err) {
        console.log('Backend offline, guardado local (SSG)');
      }

      agregarFilaCliente(nuevoCliente);
      formCli.reset();
    });

    btnRefrescarCli?.addEventListener('click', async () => {
      alertCargandoCli.classList.remove('d-none');
      alertCargandoCli.classList.add('d-flex');
      try {
        const res = await fetch('http://localhost:3000/api/clientes');
        if (res.ok) {
          const data = await res.json();
          tbodyCli.innerHTML = '';
          data.forEach((c: any) => agregarFilaCliente(c));
        }
      } catch (err) {
        console.log('Error al conectar con backend');
      } finally {
        setTimeout(() => {
          alertCargandoCli.classList.remove('d-flex');
          alertCargandoCli.classList.add('d-none');
        }, 400);
      }
    });
  </script>
</Layout>
