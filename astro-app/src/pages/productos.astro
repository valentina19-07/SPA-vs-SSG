---
import Layout from '../layouts/Layout.astro';

// Datos pre-renderizados estáticamente (SSG)
const initialProductos = [
  {
    id: 'p-1',
    nombre: 'Balón de Baloncesto Pro',
    precio: '49.99',
    categoria: 'Deportes',
    descripcion: 'Balón oficial de cuero sintético para duela y asfalto.',
  },
  {
    id: 'p-2',
    nombre: 'Zapatillas Alta Amortiguación',
    precio: '129.50',
    categoria: 'Calzado',
    descripcion: 'Diseñadas para maximizar el salto y la tracción.',
  },
  {
    id: 'p-3',
    nombre: 'Camiseta de Juego Transpirable',
    precio: '35.00',
    categoria: 'Ropa',
    descripcion: 'Tela dry-fit con ventilación estratégica.',
  },
  {
    id: 'p-4',
    nombre: 'Mochila Deportiva Resistente',
    precio: '45.00',
    categoria: 'Accesorios',
    descripcion: 'Compartimento especial para calzado y balón.',
  },
  {
    id: 'p-5',
    nombre: 'Reloj Inteligente Fitness Tracker',
    precio: '89.90',
    categoria: 'Tecnología',
    descripcion: 'Monitor de ritmo cardíaco y contador de pasos.',
  }
];
---

<Layout title="Módulo de Productos (SSG)" activePage="productos">
  <div class="dsb-container">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h2 class="h3 fw-bold text-dark mb-0">Módulo de Productos (SSG)</h2>
        <p class="text-muted mb-0">Catálogo de productos pre-renderizados con Astro (Generación de Sitio Estático)</p>
      </div>
      <button
        type="button"
        id="btn-refrescar-productos"
        class="btn btn-primary d-flex align-items-center"
      >
        <i class="bi bi-arrow-clockwise me-1"></i>
        Refrescar Datos
      </button>
    </div>

    <div id="alert-cargando" class="alert alert-info d-none align-items-center" role="alert">
      <div class="spinner-border spinner-border-sm me-2 text-info" role="status"></div>
      <span>Cargando productos actualizados desde el backend...</span>
    </div>

    <!-- Formulario de creación de producto (mismos campos que Angular) -->
    <div class="row mb-4">
      <div class="col-12">
        <div class="card shadow-sm border-0">
          <div class="card-header bg-primary text-white">
            <h5 class="mb-0 fs-6 fw-bold">Agregar Nuevo Producto</h5>
          </div>
          <div class="card-body">
            <form id="form-producto">
              <div class="row g-3">
                <div class="col-md-3">
                  <label for="prod-nombre" class="form-label small fw-semibold">Nombre del Producto <span class="text-danger">*</span></label>
                  <input
                    type="text"
                    class="form-control"
                    id="prod-nombre"
                    placeholder="Ej. Balón Profesional"
                    required
                  />
                </div>
                <div class="col-md-3">
                  <label for="prod-precio" class="form-label small fw-semibold">Precio <span class="text-danger">*</span></label>
                  <input
                    type="number"
                    step="0.01"
                    class="form-control"
                    id="prod-precio"
                    placeholder="Ej. 59.99"
                    required
                  />
                </div>
                <div class="col-md-3">
                  <label for="prod-categoria" class="form-label small fw-semibold">Categoría</label>
                  <input
                    type="text"
                    class="form-control"
                    id="prod-categoria"
                    placeholder="Ej. Deportes"
                  />
                </div>
                <div class="col-md-3">
                  <label for="prod-descripcion" class="form-label small fw-semibold">Descripción</label>
                  <input
                    type="text"
                    class="form-control"
                    id="prod-descripcion"
                    placeholder="Breve descripción"
                  />
                </div>
              </div>
              <div class="mt-3 text-end">
                <button
                  type="submit"
                  id="btn-guardar-producto"
                  class="btn btn-success"
                >
                  <i class="bi bi-plus-circle me-1"></i>
                  Crear Producto
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- Tabla de productos equivalente al de Angular -->
    <div class="table-responsive">
      <table class="table table-hover table-striped align-middle border">
        <thead class="table-dark">
          <tr>
            <th style="width: 15%;">ID</th>
            <th style="width: 25%;">Nombre</th>
            <th style="width: 15%;">Categoría</th>
            <th style="width: 15%;">Precio</th>
            <th style="width: 30%;">Descripción</th>
          </tr>
        </thead>
        <tbody id="tabla-productos-body">
          {initialProductos.map((prod) => (
            <tr>
              <td><code>{prod.id}</code></td>
              <td class="fw-bold">{prod.nombre}</td>
              <td>
                <span class="badge bg-info text-dark">
                  {prod.categoria}
                </span>
              </td>
              <td class="text-success fw-bold">${prod.precio}</td>
              <td class="text-muted small">{prod.descripcion}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <script>
    const form = document.getElementById('form-producto') as HTMLFormElement;
    const tbody = document.getElementById('tabla-productos-body') as HTMLElement;
    const btnRefrescar = document.getElementById('btn-refrescar-productos') as HTMLButtonElement;
    const alertCargando = document.getElementById('alert-cargando') as HTMLElement;

    // Función para renderizar fila
    function agregarFila(prod: any) {
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td><code>${prod.id}</code></td>
        <td class="fw-bold">${prod.nombre}</td>
        <td><span class="badge bg-info text-dark">${prod.categoria || 'General'}</span></td>
        <td class="text-success fw-bold">$${prod.precio}</td>
        <td class="text-muted small">${prod.descripcion || 'Sin descripción'}</td>
      `;
      tbody.prepend(tr);
    }

    // Agregar producto
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const nombreInput = document.getElementById('prod-nombre') as HTMLInputElement;
      const precioInput = document.getElementById('prod-precio') as HTMLInputElement;
      const catInput = document.getElementById('prod-categoria') as HTMLInputElement;
      const descInput = document.getElementById('prod-descripcion') as HTMLInputElement;

      const nuevo = {
        id: 'p-' + Date.now().toString().slice(-4),
        nombre: nombreInput.value,
        precio: precioInput.value,
        categoria: catInput.value || 'General',
        descripcion: descInput.value || 'Sin descripción',
      };

      try {
        await fetch('http://localhost:3000/api/productos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(nuevo),
        });
      } catch (err) {
        console.log('Backend offline, guardando localmente (SSG client mode)');
      }

      agregarFila(nuevo);
      form.reset();
    });

    // Refrescar desde API
    btnRefrescar?.addEventListener('click', async () => {
      alertCargando.classList.remove('d-none');
      alertCargando.classList.add('d-flex');
      try {
        const res = await fetch('http://localhost:3000/api/productos');
        if (res.ok) {
          const data = await res.json();
          tbody.innerHTML = '';
          data.forEach((p: any) => agregarFila(p));
        }
      } catch (err) {
        console.log('No se pudo conectar al backend');
      } finally {
        setTimeout(() => {
          alertCargando.classList.remove('d-flex');
          alertCargando.classList.add('d-none');
        }, 400);
      }
    });
  </script>
</Layout>
